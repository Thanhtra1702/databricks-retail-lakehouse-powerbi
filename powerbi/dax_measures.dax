/* =========================================================================
   DAX MEASURES LIBRARY: RETAIL EXECUTIVE ANALYTICS (UPDATED)
   Model: Star Schema (fact_sales_daily, dim_product, dim_customer, dim_date)
   ========================================================================= */

// -------------------------------------------------------------------------
// 1. DATE TABLE DEFINITION
// -------------------------------------------------------------------------
dim_date = 
ADDCOLUMNS (
    CALENDARAUTO(),
    "Year", YEAR([Date]),
    "MonthNumber", MONTH([Date]),
    "MonthName", FORMAT([Date], "mmmm"),
    "MonthYear", FORMAT([Date], "mmm yyyy"),
    "MonthYearSort", FORMAT([Date], "yyyymm"),
    "Quarter", "Q" & FORMAT([Date], "Q")
)

// -------------------------------------------------------------------------
// 2. CORE PERFORMANCE MEASURES
// -------------------------------------------------------------------------

// Doanh thu thuần
[Total Net Sales] = 
SUM('fact_sales_daily'[total_sales_amount])

// Tổng số đơn hàng duy nhất (Degenerate Dimension)
[Total Orders] = 
DISTINCTCOUNT('fact_sales_daily'[order_id])

// Tổng số lượng sản phẩm bán ra
[Total Units Sold] = 
SUM('fact_sales_daily'[quantity])

// Giá trị đơn hàng trung bình (AOV)
[Average Order Value] = 
DIVIDE([Total Net Sales], [Total Orders], 0)

// -------------------------------------------------------------------------
// 3. TIME INTELLIGENCE & DYNAMIC GROWTH
// -------------------------------------------------------------------------

// Tỷ lệ tăng trưởng doanh thu so với tháng trước (tự động so sánh tháng gần nhất)
[Sales Growth MoM %] = 
VAR LatestDate = MAX('dim_date'[Date])
VAR CurrentMonthSales = CALCULATE([Total Net Sales], DATESMTD('dim_date'[Date]))
VAR PreviousMonthSales = CALCULATE([Total Net Sales], DATEADD(DATESMTD('dim_date'[Date]), -1, MONTH))
RETURN
DIVIDE(CurrentMonthSales - PreviousMonthSales, PreviousMonthSales, 0)